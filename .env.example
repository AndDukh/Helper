# Core
PROJECT_NAME=helper
ENV=local

# Postgres
POSTGRES_DB=helper
POSTGRES_USER=helper
POSTGRES_PASSWORD=helper
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://helper:helper@localhost:5432/helper

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Telegram — get token from @BotFather (never commit real tokens)
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the Mini App (same origin as Next.js). Example: https://xxxx.ngrok-free.app
WEBAPP_URL=

# App placeholders
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# STT: hipc_whisper_api = Docker service whisper-api (https://github.com/Hipc/whisper-api)
#       openai_whisper_api = OpenAI cloud (needs OPENAI_API_KEY)
STT_PROVIDER=hipc_whisper_api
WHISPER_API_BASE_URL=http://localhost:8100
WHISPER_API_POLL_TIMEOUT=600
WHISPER_API_LANGUAGE=
CLAWBOT_API_URL=
CLAWBOT_API_KEY=
