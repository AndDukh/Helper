# Core
PROJECT_NAME=helper
ENV=local

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# URL of the backend service. Next.js rewrites /api/* → <API_PROXY_TARGET>/*
# In Railway: set this to your backend service URL, e.g.:
#   https://helper-backend-production.up.railway.app
API_PROXY_TARGET=http://127.0.0.1:8000

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
# Extra CORS origins (comma-separated). The Railway frontend domain and
# localhost variants are always included automatically.
# CORS_ORIGINS=https://my-custom-domain.com

# Postgres
POSTGRES_DB=helper
POSTGRES_USER=helper
POSTGRES_PASSWORD=helper
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://helper:helper@localhost:5432/helper

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Telegram — get token from @BotFather (never commit real tokens)
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the Mini App (same origin as Next.js). Example: https://xxxx.ngrok-free.app
WEBAPP_URL=

# App placeholders
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
# Optional, default is Moonshot compatible API
KIMI_API_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=moonshot-v1-8k
# STT:
# - openai_whisper_local = local Whisper model from https://github.com/openai/whisper
# - openai_whisper_api = OpenAI cloud whisper-1 (needs OPENAI_API_KEY)
STT_PROVIDER=openai_whisper_local
WHISPER_MODEL=small
CLAWBOT_API_URL=
CLAWBOT_API_KEY=

# Cloud integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_ACCESS_TOKEN=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=
DROPBOX_ACCESS_TOKEN=
